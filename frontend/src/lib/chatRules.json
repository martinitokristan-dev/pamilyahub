                "reason"
            ]
        },
        {
            "intent": "deposit",
            "pattern": "(?:received|got paid|earned|made|credited|got)\\s*(\\d+(?:\\.\\d+)?)\\s*(?:pesos?|php|bucks?|₱)?\\s*(?:from|via|in|into|to)?\\s*([a-zA-Z\\s]*)",
            "groups": [
                "amount",
                "wallet"
            ]
        },
        {
            "intent": "transfer",
            "pattern": "(?:moved|shifted|swiped|transferred|sent)\\s*(\\d+(?:\\.\\d+)?)\\s*(?:pesos?|php|bucks?|₱)?\\s*(?:from)\\s+([a-zA-Z\\s]+?)\\s*(?:to)\\s+([a-zA-Z\\s]+)",
