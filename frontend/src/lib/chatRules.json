            "intent": "log_expense",
            "pattern": "(?:dropped|spent|paid|wasted|bought|grabbed|splurged|charged)\\s*(\\d+(?:\\.\\d+)?)\\s*(?:pesos?|php|bucks?|₱)?\\s*(?:on|for)\\s+([a-zA-Z\\s]+)",
